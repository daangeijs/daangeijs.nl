---
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';

export async function getStaticPaths() {
  const projects = await getCollection('projects', ({ data }) => !data.draft);
  return projects.map((project) => ({ params: { id: project.id }, props: { project } }));
}

const { project } = Astro.props;
const { Content } = await render(project);
const { title, summary, description, thumbnail, role, timeframe, external_url } = project.data;
---

<Base title={title} description={description ?? summary}>
  <article data-pagefind-body>
    <header>
      <h1>{title}</h1>
      <p class="summary">{summary}</p>
      <p class="meta">
        {role}
        {role && timeframe && ' · '}
        {timeframe}
        {
          external_url && (
            <>
              {' · '}
              <a href={external_url} target="_blank" rel="noopener">
                visit →
              </a>
            </>
          )
        }
      </p>
      {thumbnail && <Image src={thumbnail} alt="" width={1200} class="cover" />}
    </header>
    <div class="prose">
      <Content />
    </div>
  </article>
</Base>

<style>
  header {
    margin-bottom: 2rem;
  }

  header h1 {
    margin-bottom: 0.5rem;
  }

  .summary {
    color: var(--ink-dim);
    font-size: 1.1rem;
  }

  header .meta {
    margin-top: 0.4rem;
  }

  .cover {
    border-radius: var(--radius);
    margin-top: 1.5rem;
  }
</style>
