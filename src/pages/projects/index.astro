---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import ProjectCard from '../../components/ProjectCard.astro';

const projects = (await getCollection('projects', ({ data }) => !data.draft)).sort(
  (a, b) => a.data.weight - b.data.weight
);
---

<Base
  title="Projects"
  description="Product and engineering projects by Daan Geijs, from clinical AI to self-hosted infrastructure."
  wide
>
  <Breadcrumbs crumbs={[]} current="Some stuff I have done" />
  <h1>Some stuff I have done</h1>
  <p class="intro">
    Things I helped figure out and build, written up the way I think about them: what problem
    was worth solving, how we found out, and what shipped. This page is a work in progress, I'm
    steadily writing more of them up.
  </p>
  <div class="grid">
    {projects.map((project) => <ProjectCard project={project} />)}
  </div>
  <p class="more-soon">More write-ups on the way.</p>
</Base>

<style>
  h1 {
    margin-bottom: 0.75rem;
  }

  .intro {
    color: var(--ink-dim);
    margin-bottom: 2rem;
    max-width: 44rem;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 1.25rem;
  }

  .more-soon {
    margin-top: 1.4rem;
    font-family: var(--font-mono);
    font-weight: 300;
    font-size: 0.9rem;
    color: var(--ink);
    opacity: 0.4;
  }
</style>
