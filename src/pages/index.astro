---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import ProjectCard from '../components/ProjectCard.astro';
import MediaCard from '../components/MediaCard.astro';
import PublicationItem from '../components/PublicationItem.astro';
import SocialIcons from '../components/SocialIcons.astro';
import { byDateDesc, formatDate, readingTime, visiblePosts } from '../lib/site';
import profile from '../assets/profile.jpg';
import marquee from '../data/marquee.json';

const projects = (await getCollection('projects', ({ data }) => !data.draft))
  .sort((a, b) => a.data.weight - b.data.weight)
  .slice(0, 4);
const posts = visiblePosts(await getCollection('posts')).slice(0, 5);
const media = (await getCollection('media')).sort(byDateDesc).slice(0, 3);
const publications = (await getCollection('publications')).sort(byDateDesc).slice(0, 3);
const pubCount = (await getCollection('publications')).length;
---

<Base wide>
  <section class="hero">
    <Image src={profile} alt="Portrait of Daan Geijs" width={280} class="portrait" />
    <div class="hero-text">
      <p class="greeting">Hey! I'm Daan,</p>
      <h1>I figure out what to build — and then build it.</h1>
      <p class="sub">
        Product Discovery Lead at <a href="https://kaiko.ai" target="_blank" rel="noopener"
          >kaiko.ai</a
        >. Ten years of training deep learning models and bringing AI into the clinic taught me:
        shipping is the easy part — knowing <em>what</em> to ship is the hard part.
      </p>
      <SocialIcons />
    </div>
  </section>

  <div class="marquee" aria-hidden="true">
    <div class="marquee-track">
      {
        [...marquee, ...marquee].map((item) => (
          <span class="marquee-item">
            {item}
            <span class="dot">•</span>
          </span>
        ))
      }
    </div>
  </div>

  <section class="about prose">
    <p>
      By training I'm a machine learning engineer — since 2016, from designing my own deep
      learning architectures to getting them running in an actual clinic. I did a PhD in
      computational pathology and hold a double master's in biomedical engineering and physics
      education. Today I lead product discovery, because the models were never the point; what
      they change for the person using them is.
    </p>
    <p>
      On the side I run <a href="https://alpacus.nl" target="_blank" rel="noopener">Alpacus</a>,
      my freelance practice — engineering when there's a clear thing to build, and early product
      consulting when the harder question is what to build at all.
      <a href="/work-with-me/">Work with me →</a>
    </p>
  </section>

  <section>
    <h2 class="section-title">Some things I've built</h2>
    <div class="grid-3">
      {projects.map((project) => <ProjectCard project={project} />)}
    </div>
    <p class="more"><a href="/projects/">All projects →</a></p>
  </section>

  <section>
    <h2 class="section-title">Writing</h2>
    <ul class="writing">
      {
        posts.map((post) => (
          <li>
            <a href={`/posts/${post.id}/`}>
              <span class="w-title">{post.data.title}</span>
              <span class="w-meta meta">
                {formatDate(post.data.date)} · {readingTime(post.body ?? '')} min
              </span>
            </a>
          </li>
        ))
      }
    </ul>
    <p class="more"><a href="/posts/">All writing →</a></p>
  </section>

  <section>
    <h2 class="section-title">In the media</h2>
    <div class="grid-3">
      {media.map((item) => <MediaCard item={item} />)}
    </div>
    <p class="more"><a href="/media/">All media →</a></p>
  </section>

  <section>
    <h2 class="section-title">Selected publications</h2>
    <ul class="pubs">
      {publications.map((pub) => <PublicationItem pub={pub} authorCount={1} />)}
    </ul>
    <p class="more"><a href="/publications/">All {pubCount} publications →</a></p>
  </section>
</Base>

<style>
  .hero {
    display: flex;
    align-items: center;
    gap: 2.5rem;
    padding: 1.5rem 0 2.5rem;
  }

  .hero .portrait {
    width: 150px;
    height: 150px;
    border-radius: 50%;
    object-fit: cover;
    flex-shrink: 0;
  }

  .greeting {
    color: var(--ink-dim);
    font-size: 1.1rem;
    margin-bottom: 0.3rem;
  }

  .hero h1 {
    font-size: clamp(1.7rem, 4vw, 2.6rem);
    letter-spacing: -0.02em;
  }

  .sub {
    color: var(--ink-dim);
    font-size: 1.05rem;
    margin-top: 0.8rem;
    max-width: 40rem;
  }

  .hero :global(.social) {
    margin-top: 1.1rem;
  }

  /* Marquee */
  .marquee {
    overflow: hidden;
    border-block: 1px solid var(--line);
    padding: 0.7rem 0;
    margin: 1rem 0 3rem;
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent);
    mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent);
  }

  .marquee-track {
    display: flex;
    width: max-content;
    animation: scroll 40s linear infinite;
  }

  .marquee-item {
    display: inline-flex;
    align-items: center;
    gap: 1.5rem;
    padding-right: 1.5rem;
    white-space: nowrap;
    font-family: var(--font-mono);
    font-size: 0.9rem;
    color: var(--ink-dim);
  }

  .dot {
    color: var(--accent);
  }

  @keyframes scroll {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(-50%);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .marquee-track {
      animation: none;
      flex-wrap: wrap;
      width: 100%;
    }
  }

  .about {
    max-width: 44rem;
    margin-bottom: 3.5rem;
    font-size: 1.08rem;
  }

  section + section {
    margin-top: 3.5rem;
  }

  .grid-3 {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1rem;
  }

  .writing {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .writing li {
    border-top: 1px solid var(--line);
  }

  .writing li:last-child {
    border-bottom: 1px solid var(--line);
  }

  .writing a {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
    padding: 0.8rem 0;
    color: var(--ink);
  }

  .writing a:hover {
    text-decoration: none;
  }

  .writing a:hover .w-title {
    color: var(--accent);
  }

  .w-meta {
    flex-shrink: 0;
    font-size: 0.82rem;
  }

  .pubs {
    padding: 0;
    margin: 0;
  }

  .more {
    margin-top: 1.2rem;
    font-size: 0.95rem;
  }

  @media (max-width: 800px) {
    .grid-3 {
      grid-template-columns: 1fr;
    }

    .hero {
      flex-direction: column;
      text-align: center;
      gap: 1.25rem;
    }

    .hero .sub {
      margin-inline: auto;
    }

    .hero :global(.social) {
      justify-content: center;
    }

    .writing a {
      flex-direction: column;
      gap: 0.15rem;
    }
  }
</style>
