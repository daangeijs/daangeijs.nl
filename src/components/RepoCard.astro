---
interface Props {
  name: string;
  url: string;
  description: string;
  language: string;
  stars: number;
  forks: number;
}

const { name, url, description, language, stars, forks } = Astro.props;
---

<article class="card repo">
  <h3><a href={url} target="_blank" rel="noopener">{name}</a></h3>
  <p class="desc">{description}</p>
  <p class="meta">
    <span>{language}</span>
    <span>★ {stars}</span>
    <span>⑂ {forks}</span>
  </p>
</article>

<style>
  .repo {
    padding: 1rem 1.2rem;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  h3 {
    font-size: 1rem;
  }

  .desc {
    color: var(--ink-dim);
    font-size: 0.9rem;
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    overflow: hidden;
  }

  .meta {
    margin-top: auto;
    display: flex;
    gap: 1rem;
  }
</style>
