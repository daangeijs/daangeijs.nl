---
// Simple breadcrumb trail: Home / Section / current page.
// `crumbs` are the linked ancestors; `current` is the unlinked leaf.
interface Crumb {
  label: string;
  href: string;
}
interface Props {
  crumbs: Crumb[];
  current: string;
}
const { crumbs, current } = Astro.props;
const trail: Crumb[] = [{ label: 'Home', href: '/' }, ...crumbs];
---

<nav class="breadcrumbs" aria-label="Breadcrumb">
  <ol>
    {
      trail.map((c) => (
        <li>
          <a href={c.href}>{c.label}</a>
          <span class="sep" aria-hidden="true">/</span>
        </li>
      ))
    }
    <li aria-current="page"><span class="current">{current}</span></li>
  </ol>
</nav>

<style>
  .breadcrumbs {
    margin-bottom: 1.6rem;
  }

  .breadcrumbs ol {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem;
    list-style: none;
    padding: 0;
    margin: 0;
    font-family: var(--font-mono);
    font-weight: 300;
    font-size: 0.85rem;
  }

  .breadcrumbs li {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
  }

  .breadcrumbs a {
    color: var(--ink);
    opacity: 0.5;
    text-decoration: none;
    transition: opacity 0.2s ease;
  }

  .breadcrumbs a:hover {
    opacity: 0.9;
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .sep {
    color: var(--ink);
    opacity: 0.28;
  }

  .current {
    color: var(--ink);
    opacity: 0.7;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    max-width: 46ch;
  }
</style>
