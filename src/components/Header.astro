---
import ThemeToggle from './ThemeToggle.astro';

const nav = [
  { label: 'Home', href: '/' },
  { label: 'Projects', href: '/projects/' },
  { label: 'Writing', href: '/posts/' },
  { label: 'Media', href: '/media/' },
  { label: 'Publications', href: '/publications/' },
  { label: 'Work with me', href: '/work-with-me/' },
];

const { pathname } = Astro.url;
const isActive = (href: string) =>
  href === '/' ? pathname === '/' : pathname.startsWith(href);
---

<div class="blur-overlay" aria-hidden="true"></div>

<header>
  <div class="header-inner">
    <a class="brand" href="/" aria-label="Daan Geijs, home">
      <span class="logo-mark">DG</span>
    </a>
    <div class="actions">
      <button class="icon-btn hide-on-open" id="search-toggle" aria-label="Search" aria-controls="search-overlay" aria-expanded="false">
        <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"
          ><path
            fill="currentColor"
            d="M9.5 3A6.5 6.5 0 0 1 16 9.5c0 1.61-.59 3.09-1.56 4.23l.27.27h.79l5 5-1.5 1.5-5-5v-.79l-.27-.27A6.52 6.52 0 0 1 9.5 16 6.5 6.5 0 0 1 3 9.5 6.5 6.5 0 0 1 9.5 3m0 2C7 5 5 7 5 9.5S7 14 9.5 14 14 12 14 9.5 12 5 9.5 5Z"
          ></path></svg
        >
      </button>
      <span class="hide-on-open"><ThemeToggle /></span>
      <button class="icon-btn" id="nav-toggle" aria-label="Open menu" aria-expanded="false" aria-controls="main-nav">
        <svg class="i-menu" viewBox="0 0 24 24" width="24" height="24" aria-hidden="true"
          ><path fill="currentColor" d="M3 6h18v2H3zm0 5h18v2H3zm0 5h18v2H3z"></path></svg
        >
        <svg class="i-close" viewBox="0 0 24 24" width="24" height="24" aria-hidden="true"
          ><path
            fill="currentColor"
            d="M19 6.41 17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z"
          ></path></svg
        >
      </button>
    </div>
  </div>
</header>

<nav class="overlay-nav" id="main-nav" aria-label="Main">
  <ol>
    {
      nav.map(({ label, href }, i) => (
        <li>
          <a href={href} aria-current={isActive(href) ? 'page' : undefined} style={`--i: ${i}`}>
            <span class="num">{String(i + 1).padStart(2, '0')}</span>
            <span class="label">{label}</span>
          </a>
        </li>
      ))
    }
  </ol>
</nav>

<style>
  /* Soft blur at the very top of the page, like theodore.net */
  .blur-overlay {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    height: 90px;
    pointer-events: none;
    z-index: 25;
    backdrop-filter: blur(28px);
    -webkit-backdrop-filter: blur(28px);
    mask-image: linear-gradient(
      to bottom,
      black 0%,
      rgba(0, 0, 0, 0.9) 20%,
      rgba(0, 0, 0, 0.55) 45%,
      transparent 100%
    );
    -webkit-mask-image: linear-gradient(
      to bottom,
      black 0%,
      rgba(0, 0, 0, 0.9) 20%,
      rgba(0, 0, 0, 0.55) 45%,
      transparent 100%
    );
  }

  header {
    position: sticky;
    top: 0;
    z-index: 30;
    background: none;
    border: 0;
  }

  .header-inner {
    max-width: calc(var(--w-wide) + 3rem);
    margin: 0 auto;
    padding: 1.4rem 1.5rem 0.4rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .brand {
    display: inline-flex;
    text-decoration: none;
  }

  /* Solid DG monogram disc: reversed-out serif letters on an ink fill,
     inverting to an outline on hover. */
  .logo-mark {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 3rem;
    height: 3rem;
    border-radius: 50%;
    border: 1.2px solid var(--ink);
    background: var(--ink);
    font-family: var(--font-serif);
    font-weight: 500;
    font-size: 1.3rem;
    letter-spacing: -0.04em;
    line-height: 1;
    color: var(--bg);
    transition: transform 0.3s ease, background 0.3s ease, color 0.3s ease;
  }

  .brand:hover .logo-mark {
    transform: scale(0.95);
    background: var(--bg);
    color: var(--ink);
  }

  .actions {
    display: flex;
    align-items: center;
    gap: 0.15rem;
  }

  .icon-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.5rem;
    height: 2.5rem;
    border: 0;
    background: transparent;
    color: var(--ink);
    cursor: pointer;
    border-radius: 8px;
    transition: opacity 0.25s ease, transform 0.3s ease;
  }

  .icon-btn:hover {
    transform: scale(0.92);
    text-decoration: none;
  }

  .i-close {
    display: none;
  }

  .hide-on-open {
    transition: opacity 0.25s ease;
  }

  /* nav open: only the close X stays; it sits on the inverted overlay */
  :global(body.nav-open) .hide-on-open {
    opacity: 0;
    pointer-events: none;
  }

  :global(body.nav-open) #nav-toggle {
    color: var(--bg);
  }

  :global(body.nav-open) .brand {
    opacity: 0;
    pointer-events: none;
  }

  /* Full-screen inverted overlay nav — theodore.net style */
  .overlay-nav {
    position: fixed;
    inset: 0;
    z-index: 28;
    background: var(--nav-ink);
    display: flex;
    align-items: center;
    transform: translateX(-100%);
    transition: transform 0.25s cubic-bezier(0.215, 0.61, 0.355, 1);
    visibility: hidden;
  }

  .overlay-nav ol {
    list-style: none;
    padding: 0 clamp(1.5rem, 8vw, 8rem);
    margin: 0 auto;
    width: 100%;
    max-width: 1200px;
    font-size: 9vmin;
  }

  .overlay-nav li {
    overflow: hidden;
  }

  .overlay-nav a {
    display: inline-flex;
    align-items: baseline;
    gap: 0.45em;
    text-decoration: none;
    color: var(--bg);
    font-family: var(--font-serif);
    font-size: 1em;
    font-weight: 400;
    line-height: 1.2;
    transform: translateY(100%);
    transition: font-style 0.15s ease;
    user-select: none;
  }

  html[data-theme='dark'] .overlay-nav a {
    color: hsl(228, 7%, 14%);
  }

  .overlay-nav a:hover .label {
    font-style: italic;
  }

  .overlay-nav a[aria-current='page'] .label {
    opacity: 0.55;
  }

  .num {
    font-size: 0.35em;
    font-weight: 300;
    font-style: italic;
    opacity: 0.75;
  }

  :global(body.nav-open) .overlay-nav {
    transform: translateX(0);
    visibility: visible;
  }

  :global(body.nav-open) .overlay-nav a {
    animation: link-appear 1.5s cubic-bezier(0.215, 0.61, 0.355, 1) forwards;
    animation-delay: calc(var(--i) * 0.03s);
  }

  @keyframes link-appear {
    0%,
    25% {
      transform: translateY(100%);
    }
    50%,
    100% {
      transform: translateY(0);
    }
  }

  :global(body.nav-open) .i-menu {
    display: none;
  }

  :global(body.nav-open) .i-close {
    display: block;
  }

  @media (prefers-reduced-motion: reduce) {
    .overlay-nav a {
      transform: none;
    }
    :global(body.nav-open) .overlay-nav a {
      animation: none;
    }
  }
</style>

<script>
  const toggle = document.getElementById('nav-toggle')!;
  const setOpen = (open: boolean) => {
    document.body.classList.toggle('nav-open', open);
    toggle.setAttribute('aria-expanded', String(open));
    toggle.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
  };
  toggle.addEventListener('click', () =>
    setOpen(!document.body.classList.contains('nav-open'))
  );
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') setOpen(false);
  });
  document.querySelectorAll('#main-nav a').forEach((a) =>
    a.addEventListener('click', () => setOpen(false))
  );
</script>
