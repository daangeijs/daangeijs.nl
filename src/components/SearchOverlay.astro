---
// Theodore-style modal search. Opens via the header search icon, Cmd/Ctrl+K, or "/".
// Uses Pagefind's low-level JS API (not the default UI) so the markup is fully ours.
// The index exists only in the production build, so it is lazy-loaded on first open.
---

<div id="search-overlay" class="search-overlay" role="dialog" aria-modal="true" aria-label="Search" hidden>
  <div class="search-backdrop" data-search-close></div>
  <div class="search-panel">
    <div class="search-box">
      <svg class="search-icon" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"
        ><path
          fill="currentColor"
          d="M9.5 3A6.5 6.5 0 0 1 16 9.5c0 1.61-.59 3.09-1.56 4.23l.27.27h.79l5 5-1.5 1.5-5-5v-.79l-.27-.27A6.52 6.52 0 0 1 9.5 16 6.5 6.5 0 0 1 3 9.5 6.5 6.5 0 0 1 9.5 3m0 2C7 5 5 7 5 9.5S7 14 9.5 14 14 12 14 9.5 12 5 9.5 5Z"
        ></path></svg
      >
      <input
        id="search-input"
        type="search"
        placeholder="Search writing, projects, publications…"
        autocomplete="off"
        spellcheck="false"
        aria-label="Search"
      />
      <kbd class="search-esc">esc</kbd>
    </div>
    <div id="search-results" class="search-results" aria-live="polite"></div>
  </div>
</div>

<script>
  const overlay = document.getElementById('search-overlay');
  const input = document.getElementById('search-input') as HTMLInputElement | null;
  const resultsEl = document.getElementById('search-results');
  const toggle = document.getElementById('search-toggle');

  let pagefind: any = null;
  let loadPromise: Promise<boolean> | null = null;
  let debounce: number | undefined;
  let lastQuery = '';

  function loadPagefind(): Promise<boolean> {
    if (loadPromise) return loadPromise;
    loadPromise = (async () => {
      try {
        // Import via a Function-wrapped expression so Vite never sees a real import() to
        // transform. A literal (or even @vite-ignore'd) import() makes Vite inject a preload
        // helper (__VITE_PRELOAD__) that is undefined in this inlined script, and the pagefind
        // bundle only exists after the post-build `pagefind` step anyway.
        const dynImport = new Function('u', 'return import(u)') as (u: string) => Promise<any>;
        pagefind = await dynImport('/pagefind/pagefind.js');
        await pagefind.options({ excerptLength: 20 });
        await pagefind.init();
        return true;
      } catch {
        if (resultsEl) {
          resultsEl.innerHTML =
            '<p class="search-note">Search is only available on the deployed site.</p>';
        }
        return false;
      }
    })();
    return loadPromise;
  }

  function escapeAttr(s: string) {
    return s.replace(/"/g, '&quot;');
  }

  async function runSearch(query: string) {
    if (!resultsEl) return;
    if (!query.trim()) {
      resultsEl.innerHTML = '';
      return;
    }
    const ready = await loadPagefind();
    if (!ready || !pagefind) return;
    if (query !== lastQuery) return; // a newer query already fired

    const search = await pagefind.search(query);
    if (query !== lastQuery) return; // a newer query already fired

    const items = await Promise.all(search.results.slice(0, 8).map((r: any) => r.data()));

    if (!items.length) {
      resultsEl.innerHTML = `<p class="search-note">No results for “${query}”.</p>`;
      return;
    }

    resultsEl.innerHTML = items
      .map((d: any) => {
        const title = d.meta?.title ?? d.url;
        return `<a class="search-hit" href="${escapeAttr(d.url)}">
            <span class="hit-title">${title}</span>
            <span class="hit-excerpt">${d.excerpt}</span>
          </a>`;
      })
      .join('');
  }

  function onInput() {
    if (!input) return;
    lastQuery = input.value;
    window.clearTimeout(debounce);
    debounce = window.setTimeout(() => runSearch(input!.value), 160);
  }

  function openSearch() {
    if (!overlay) return;
    overlay.hidden = false;
    document.body.classList.add('search-open');
    toggle?.setAttribute('aria-expanded', 'true');
    loadPagefind();
    window.setTimeout(() => input?.focus(), 30);
  }

  function closeSearch() {
    if (!overlay) return;
    overlay.hidden = true;
    document.body.classList.remove('search-open');
    toggle?.setAttribute('aria-expanded', 'false');
  }

  toggle?.addEventListener('click', openSearch);
  input?.addEventListener('input', onInput);
  overlay
    ?.querySelectorAll('[data-search-close]')
    .forEach((el) => el.addEventListener('click', closeSearch));

  document.addEventListener('keydown', (e) => {
    const active = document.activeElement as HTMLElement | null;
    const isTyping =
      active &&
      (active.tagName === 'INPUT' || active.tagName === 'TEXTAREA' || active.isContentEditable);

    if ((e.key === 'k' && (e.metaKey || e.ctrlKey)) || (e.key === '/' && !isTyping)) {
      e.preventDefault();
      if (overlay?.hidden) openSearch();
    } else if (e.key === 'Escape' && !overlay?.hidden) {
      closeSearch();
    }
  });
</script>

<style is:global>
  .search-overlay {
    position: fixed;
    inset: 0;
    z-index: 60;
    display: flex;
    align-items: flex-start;
    justify-content: center;
  }

  .search-overlay[hidden] {
    display: none;
  }

  .search-backdrop {
    position: absolute;
    inset: 0;
    background: color-mix(in srgb, var(--bg) 68%, transparent);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
  }

  .search-panel {
    position: relative;
    width: min(620px, calc(100vw - 2rem));
    margin-top: 13vh;
    background: var(--bg);
    border: 1.2px solid var(--line);
    border-radius: 22px;
    box-shadow: 0 24px 80px rgba(0, 0, 0, 0.18);
    padding: 0.9rem;
    animation: search-pop 0.24s ease;
  }

  @keyframes search-pop {
    from {
      opacity: 0;
      transform: translateY(-8px);
    }
  }

  .search-box {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    padding: 0.5rem 0.75rem;
    border-bottom: 1.2px solid var(--line);
  }

  .search-icon {
    color: var(--ink);
    opacity: 0.4;
    flex-shrink: 0;
  }

  #search-input {
    flex: 1;
    border: none;
    outline: none;
    background: transparent;
    font-family: var(--font-mono);
    font-weight: 300;
    font-size: 1.05rem;
    color: var(--ink);
    padding: 0.25rem 0;
  }

  #search-input::placeholder {
    color: var(--ink);
    opacity: 0.35;
  }

  /* Kill the native clear affordance from type=search */
  #search-input::-webkit-search-decoration,
  #search-input::-webkit-search-cancel-button {
    -webkit-appearance: none;
    appearance: none;
  }

  .search-esc {
    font-family: var(--font-mono);
    font-weight: 300;
    font-size: 0.7rem;
    color: var(--ink);
    opacity: 0.4;
    border: 1.2px solid var(--line);
    border-radius: 6px;
    padding: 0.1rem 0.4rem;
    flex-shrink: 0;
  }

  .search-results {
    max-height: 58vh;
    overflow-y: auto;
    margin-top: 0.3rem;
  }

  .search-results:empty {
    display: none;
  }

  .search-hit {
    display: block;
    text-decoration: none;
    padding: 0.75rem 0.75rem;
    border-radius: 12px;
    transition: background 0.15s ease;
  }

  .search-hit:hover {
    background: color-mix(in srgb, var(--ink) 6%, transparent);
  }

  .hit-title {
    display: block;
    font-family: var(--font-serif);
    font-size: 1.15rem;
    font-weight: 400;
    color: var(--ink);
    opacity: 0.9;
  }

  .hit-excerpt {
    display: block;
    font-family: var(--font-mono);
    font-weight: 300;
    font-size: 0.85rem;
    line-height: 1.45;
    color: var(--ink);
    opacity: 0.5;
    margin-top: 0.25rem;
  }

  .hit-excerpt mark {
    background: transparent;
    color: var(--ink);
    opacity: 1;
    font-weight: 400;
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 2px;
  }

  .search-note {
    font-family: var(--font-mono);
    font-weight: 300;
    font-size: 0.9rem;
    color: var(--ink);
    opacity: 0.5;
    padding: 0.9rem 0.75rem;
  }

  body.search-open {
    overflow: hidden;
  }

  @media (prefers-reduced-motion: reduce) {
    .search-panel {
      animation: none;
    }
  }
</style>
